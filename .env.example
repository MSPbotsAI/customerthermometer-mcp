# Optional overrides — customerthermometer-mcp has no required env vars.
# Authentication is per-request via two request headers, since MSPbots'
# own integration stores both the API key and the API URL as per-tenant
# fields (Customer Thermometer supports regional/custom API hosts):
#   X-CustomerThermometer-Api-Key — your Customer Thermometer API key
#     (found under Automations in the Customer Thermometer UI)
#   X-CustomerThermometer-Api-Url — the API host, e.g.
#     app.customerthermometer.com/api.php
# This server sends the key as the "apiKey" query parameter on every call
# (the vendor's "super API key" style — no separate Bearer header), exactly
# matching MSPbots' own configured usage.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
